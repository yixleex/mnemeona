venv/
.venv/
env/
.env/
.env.*

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
dist/
build/
*.egg-info/

# ============================================================
# Local configuration
# ============================================================

# Local environment overrides
*.local.json
*.local.yaml
*.local.yml

